<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=00814bb50ec20a843ae6eca73721a9c6&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="MainMenuContainer" style="flex-grow: 1; background-color: rgb(201, 161, 206); -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; display: flex; align-items: center; align-self: auto; justify-content: center;">
        <ui:Label tabindex="-1" text="Paul&apos;s Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" class="header" style="background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0);" />
        <ui:Button text="Start Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="StartGame" class="button" />
        <ui:Button text="Quit" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Quit" class="button" />
    </ui:VisualElement>
    <ui:VisualElement name="GameOptionsContainer" style="background-color: rgb(148, 206, 158); height: 100%; width: 100%; justify-content: center; align-self: center; align-items: center; display: none;">
        <ui:RadioButtonGroup label="Players" value="-1" name="NumTeamsGroup" class="optionsRadioGroup">
            <ui:RadioButton label="2" value="false" />
            <ui:RadioButton label="3" />
            <ui:RadioButton label="4" value="false" />
        </ui:RadioButtonGroup>
        <ui:RadioButtonGroup label="Map Size" value="-1" name="MapSizeGroup" class="optionsRadioGroup">
            <ui:RadioButton label="Small" value="false" />
            <ui:RadioButton label="Medium" />
            <ui:RadioButton label="Jumbo" />
        </ui:RadioButtonGroup>
        <ui:RadioButtonGroup label="Map Type" value="-1" name="MapTypeGroup" class="optionsRadioGroup">
            <ui:RadioButton label="Grouped" value="false" />
            <ui:RadioButton label="Scrambled" />
        </ui:RadioButtonGroup>
        <ui:Button text="Launch Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LaunchGame" class="button" />
        <ui:Button text="Back" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Back" class="button" />
    </ui:VisualElement>
</ui:UXML>
